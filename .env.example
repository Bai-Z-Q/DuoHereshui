# ===== 数据库 =====
# 本地示例；Render + Neon 时填 Neon 连接串，例如：
# DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# PGSSLMODE=require
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/medical_assistant
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=medical_assistant
DATABASE_USER=user
DATABASE_PASSWORD=password

# ===== Redis（可选，当前版本未强依赖）=====
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== 应用 =====
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
# 是否在控制台打印每条 SQL（排查问题时开，日常保持 false）
SQL_ECHO=False
# 生产环境务必改成随机长字符串，用于签发 JWT
SECRET_KEY=change-me-to-a-long-random-string

# ===== Celery（可选，用药提醒当前使用 APScheduler，无需 Celery）=====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== 爬虫 =====
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
CRAWLER_DELAY=2
CRAWLER_MAX_RETRIES=3

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== CORS =====
# 同源部署（后端直接托管 web/dist）不需要 CORS；只填自己的域名
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000", "http://localhost:5173"]

# ===== 公网部署安全开关 =====
# 注册关闭后只允许已有账号登录
REGISTRATION_ENABLED=true
# 锁定全局模型配置：公网用户不能修改 LLM Base URL / Key / 模型，只能由服务端环境变量配置
ALLOW_LLM_SETTINGS=true

# ===== LLM / Agent（任何 OpenAI 兼容接口：DeepSeek/通义千问/豆包/Moonshot 等）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_ENABLED=true

# ===== Agent 平台（v1.2）=====
# 各能力可单独关闭，关闭后退回单 Agent + 规则链路
AGENT_ORCHESTRATOR_ENABLED=true
AGENT_MEMORY_ENABLED=true
AGENT_RAG_ENABLED=true
AGENT_GUARDRAILS_ENABLED=true
AGENT_TRACE_ENABLED=true
AGENT_TRIAGE_ENABLED=true
AGENT_MAX_TOOL_ROUNDS=4
AGENT_HISTORY_TURNS=8

# 编排引擎（v1.3）：langgraph / legacy / auto
AGENT_ENGINE=langgraph
# 进程内 Checkpointer（重启后图状态清空；对话历史仍持久化在 PostgreSQL）
AGENT_GRAPH_CHECKPOINTER=True

# 模型路由：简单药品查询走轻量模型，复杂多症状分析走强模型
# 留空则统一使用 LLM_MODEL
LLM_LIGHT_MODEL=
LLM_REASONING_MODEL=

# RAG 混合检索
RAG_TOP_K=6
RAG_INDEX_ON_STARTUP=true

# 可选向量检索（默认关闭，使用 BM25 + 结构化混合检索，零额外依赖）
# 如需 BGE-M3 等向量模型，填一个 OpenAI 兼容 /embeddings 服务
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# 漏服判定宽限（分钟）与可补服窗口
MISSED_DOSE_GRACE_MINUTES=30
MISSED_DOSE_MAKEUP_WINDOW_MINUTES=120

