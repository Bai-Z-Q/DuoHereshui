# ===== 数据库 =====
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/medical_assistant
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=medical_assistant
DATABASE_USER=user
DATABASE_PASSWORD=password

# ===== Redis（可选，当前版本未强依赖）=====
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== 应用 =====
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
# 生产环境务必改成随机长字符串，用于签发 JWT
SECRET_KEY=change-me-to-a-long-random-string

# ===== Celery（可选，用药提醒当前使用 APScheduler，无需 Celery）=====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== 爬虫 =====
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
CRAWLER_DELAY=2
CRAWLER_MAX_RETRIES=3

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== CORS（开发环境）=====
CORS_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080"]

# ===== LLM / Agent（任何 OpenAI 兼容接口：DeepSeek/通义千问/豆包/Moonshot 等）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_ENABLED=true
